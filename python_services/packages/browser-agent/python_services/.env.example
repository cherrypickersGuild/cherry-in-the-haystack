DATABASE_URL=postgresql://..

# 역할별 LLM provider 선택 (anthropic | qwen)
ANALYZE_LLM=anthropic
FALLBACK_LLM=anthropic
CLASSIFY_LLM=qwen

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Qwen (OpenAI 호환 로컬 엔드포인트) — 인증 불필요, reasoning off 필수
QWEN_BASE_URL=http://host:8000/v1
QWEN_MODEL=nvidia/Qwen3.6-27B-NVFP4
QWEN_API_KEY=dummy
QWEN_DISABLE_THINKING=true
